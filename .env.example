# ============================================================
# KURO POS - Environment Variables Template
# ============================================================
# คำแนะนำสำหรับเพื่อนในทีม:
# 1. คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น .env.local (คำสั่ง: cp .env.example .env.local)
# 2. นำค่า URL และ Key ด้านล่างไปใส่ หรือติดต่อขอคีย์จริงจากหัวหน้าทีม
# ============================================================

# Supabase Project URL (จาก Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://ipssxfrkbpvvfubfytoi.supabase.co

# Supabase Anon Public Key (สำหรับให้ Browser และ Next.js เข้าถึงฐานข้อมูล)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_zwca3CiOpDxDkfcy2GLpkw_5UfRx3xC
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zwca3CiOpDxDkfcy2GLpkw_5UfRx3xC

# (Optional) Supabase Service Role Key (เฉพาะงานระบบระดับสูง ห้ามใส่บน Client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

